# ==============================================================================
# NOVA Learning Platform — Environment Variables Example
# Duplicate this file to '.env' and provide your actual local credentials.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR DATABASE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Neon Serverless PostgreSQL Database Configuration
VITE_NEON_PROJECT_ID=your_neon_project_id_here
VITE_NEON_BRANCH=production
VITE_NEON_AUTH_URL=https://your-neon-auth-url.neon.tech/neondb/auth
VITE_NEON_DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini GenAI API Key (Optional for live LLM response generation fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
